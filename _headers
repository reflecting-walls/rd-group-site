/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/admin/*
  X-Robots-Tag: noindex, nofollow

/data/*
  X-Robots-Tag: noindex

# Cache rules per folder. They don't overlap on purpose: when two rules match, Cloudflare
# joins their Cache-Control values into one header.
/assets/css/*
  Cache-Control: public, max-age=604800

/assets/js/*
  Cache-Control: public, max-age=604800

/assets/logo/*
  Cache-Control: public, max-age=604800

/assets/img/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/assets/uploads/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Font files carry a version in their name; a new version gets a new file name.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/llms.txt
  Content-Type: text/plain; charset=utf-8
